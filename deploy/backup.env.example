# Copie para /etc/vision-backup.env (sudo chmod 600) e preencha.
# Exemplo com Backblaze B2 pela API compatível com S3; o endpoint aparece
# no painel do bucket ("Endpoint").
RESTIC_REPOSITORY=s3:https://s3.us-east-005.backblazeb2.com/NOME-DO-BUCKET
AWS_ACCESS_KEY_ID=keyID-da-application-key
AWS_SECRET_ACCESS_KEY=applicationKey
# Senha que criptografa o backup. SEM ELA NÃO HÁ COMO RESTAURAR:
# guarde também fora do servidor (gerenciador de senhas).
RESTIC_PASSWORD=troque-por-uma-senha-longa
