# VISION atrás do Caddy: HTTPS automático (Let's Encrypt).
# Copie para /etc/caddy/Caddyfile e troque o domínio.
#
# O login é do próprio VISION (usuários criados com `npm run cli -- user add`):
# a API e os vídeos em media/ só respondem com sessão válida. O webhook do War
# (/api/webhooks/war) tem segredo próprio.

vision.scalecompany.com.br {
	encode zstd gzip

	# API e mídia (media/ é servida na raiz pelo servidor Node)
	@backend path /api/* /projects/* /music/* /sfx/* /library/*
	handle @backend {
		reverse_proxy 127.0.0.1:4000
	}

	# interface web (npm run build -w @vision/web)
	handle {
		root * /opt/vision/apps/web/dist
		try_files {path} /index.html
		file_server
	}
}
