# Copie para .env (ou .env.local, que tem precedência) na raiz do repositório.

# Obrigatória: transcrição (Whisper), cortes, motions, diretor IA e narração
OPENAI_API_KEY=sk-...

# Opcional: ilustrações geradas (Magnific · Nano Banana Pro Flash, 1:1 em 1K).
# Sem ela, o tipo "Ilustração" some das sugestões e o botão de gerar avisa.
# MAGNIFIC_API_KEY=
# Teto de imagens geradas por projeto (padrão 12; inclui variações e apagadas)
# MAGNIFIC_MAX_PER_PROJECT=12
# Modelo que ouve as músicas da biblioteca (npm run cli -- library music)
# MUSIC_MODEL=gpt-audio

# Porta do servidor (padrão 4000)
# PORT=4000

# Modelos (opcionais). Padrão: gpt-4o; TAG_MODEL usa gpt-4o-mini
# DIRECTOR_MODEL=gpt-4o
# CUTS_MODEL=gpt-4o
# MOTIONS_MODEL=gpt-4o
# TAG_MODEL=gpt-4o-mini

# ─── Demandas do War ───────────────────────────────────────────────
# Mesmo segredo do War: entrada (x-webhook-secret) e saída (x-api-key).
# Webhook do War aponta para https://vision.scalecompany.com.br/api/webhooks/war
DEMANDAS_WEBHOOK_SECRET=
# WAR_BASE_URL=https://war.scalecompany.com.br

# Banco (Postgres/Supabase COMPARTILHADO com outro sistema). Rodar antes, à mão,
# db/vision.sql: cria só o schema "vision" e o usuário "vision_app".
# Conectar SEMPRE com vision_app (nunca postgres/service role). No pooler do
# Supabase o usuário fica "vision_app.<ref-do-projeto>":
#   postgresql://vision_app.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:6543/postgres
# (host exato em Connect → Transaction pooler → Shared pooler; pode ser aws-0 ou
# aws-1). No servidor use SEMPRE esse pooler: db.<ref>.supabase.co é só IPv6
# (erro ENETUNREACH em redes IPv4).
# Senha com caracteres especiais (@ : / # ?) precisa ir codificada na URL.
# Conferir depois de preencher (não grava nada): npm run cli -- db-check
# Sem esta variável, as demandas ficam em data/demands-db.json.
VISION_DATABASE_URL=
# VISION_DB_POOL=3

# Google Drive (OAuth Client "Aplicativo da Web" no Google Cloud, API do Drive ativada)
# URI de redirecionamento autorizada: <VISION_PUBLIC_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# VISION_PUBLIC_URL=https://vision.scalecompany.com.br   (padrão em dev: http://localhost:5173)

# ─── Login ──────────────────────────────────────────────────────────
# Assina as sessões (cookie). Obrigatório no servidor: openssl rand -hex 32
# Sem ele, um segredo temporário é usado e todos deslogam a cada reinício.
VISION_SESSION_SECRET=
# Acessos: npm run cli -- user add --email ... --name ... [--admin]

# ─── Limpeza automática de disco (só no servidor) ───────────────────
# on = apaga o bruto N dias após a entrega no Drive (ou M dias sem edição, sem
# entrega) e renders antigos. Desligado por padrão para não apagar nada no
# computador. Ver antes: npm run cli -- retention --dry-run
# VISION_RETENTION=on
# VISION_RAW_RETENTION_DAYS=10
# VISION_IDLE_RETENTION_DAYS=30

# ─── Render ─────────────────────────────────────────────────────────
# Abas do Chrome em paralelo (padrão: núcleos, até 8). Baixe se faltar RAM.
# RENDER_CONCURRENCY=4
# Preset do x264 (padrão veryfast; "default" volta ao medium do Remotion)
# RENDER_X264_PRESET=veryfast
# Como o Chrome desenha: padrão "angle" (GPU) no Windows e o do Remotion no
# Linux; "default" volta ao padrão do Remotion.
# RENDER_GL=angle

# Status da demanda quando o último vídeo vai ao Drive (vazio desliga)
# VISION_STATUS_ON_DELIVERY=Aprovação do Gestor
