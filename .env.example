# Copie para .env (ou .env.local, que tem precedência) na raiz do repositório.

# Obrigatória: transcrição (Whisper), cortes, motions, diretor IA e narração
OPENAI_API_KEY=sk-...

# Porta do servidor (padrão 4000)
# PORT=4000

# Modelos (opcionais). Padrão: gpt-4o; TAG_MODEL usa gpt-4o-mini
# DIRECTOR_MODEL=gpt-4o
# CUTS_MODEL=gpt-4o
# MOTIONS_MODEL=gpt-4o
# TAG_MODEL=gpt-4o-mini
